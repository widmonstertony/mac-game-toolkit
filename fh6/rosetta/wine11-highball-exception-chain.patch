+/* Local, bounded diagnostic. Observes dispatch without changing exception semantics.
+ * No game instruction, exception status or supplied CONTEXT is modified. */
+#if defined(__x86_64__) && !defined(__arm64ec__)
+static LONG observation_enabled = -1;
+static void *observation_sites[32];
+static LONG observation_counts[32];
+static LONG observation_sequence;
+
+static LONG observation_begin(EXCEPTION_RECORD *rec)
+{
+    unsigned i;
+    if (rec->ExceptionCode != STATUS_ILLEGAL_INSTRUCTION &&
+        rec->ExceptionCode != STATUS_PRIVILEGED_INSTRUCTION) return 0;
+    if (observation_enabled == -1)
+    {
+        WCHAR buffer[4];
+        UNICODE_STRING key, value;
+        RtlInitUnicodeString(&key, L"FH6_EXCEPTION_OBSERVE");
+        value.Buffer = buffer; value.Length = 0; value.MaximumLength = sizeof(buffer);
+        InterlockedCompareExchange(&observation_enabled,
+            !RtlQueryEnvironmentVariable_U(NULL, &key, &value) &&
+            value.Length == sizeof(WCHAR) && buffer[0] == '1', -1);
+    }
+    if (!observation_enabled) return 0;
+    /* Follow-up is restricted to the seven sites from the prior exception-frequency capture. */
+    {
+        static const ULONG_PTR selected[] = {0x4941fe0,0x494220c,0x44d85ad,0x44d7ff0,0x44d518c,0x44d5090,0x44d7870};
+        ULONG_PTR rva = (ULONG_PTR)rec->ExceptionAddress - (ULONG_PTR)NtCurrentTeb()->Peb->ImageBaseAddress;
+        for (i=0; i<ARRAY_SIZE(selected); ++i) if (rva == selected[i]) break;
+        if (i == ARRAY_SIZE(selected)) return 0;
+    }
+
+    /* Delay this final capture to separate startup work from the later steady workload. */
+    {
+        static LONGLONG first_tick;
+        LARGE_INTEGER tick, frequency;
+        NtQueryPerformanceCounter(&tick, &frequency);
+        InterlockedCompareExchange64(&first_tick, tick.QuadPart, 0);
