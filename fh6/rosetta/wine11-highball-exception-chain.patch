+    case 2:  RDX_sig(sigcontext) = value; break;
+    case 3:  RBX_sig(sigcontext) = value; break;
+    case 4:  RSP_sig(sigcontext) = value; break;
+    case 5:  RBP_sig(sigcontext) = value; break;
+    case 6:  RSI_sig(sigcontext) = value; break;
+    case 7:  RDI_sig(sigcontext) = value; break;
+    case 8:  R8_sig(sigcontext)  = value; break;
+    case 9:  R9_sig(sigcontext)  = value; break;
+    case 10: R10_sig(sigcontext) = value; break;
+    case 11: R11_sig(sigcontext) = value; break;
+    case 12: R12_sig(sigcontext) = value; break;
+    case 13: R13_sig(sigcontext) = value; break;
+    case 14: R14_sig(sigcontext) = value; break;
+    case 15: R15_sig(sigcontext) = value; break;
+    }
+    RIP_sig(sigcontext) += pos + 3;
+    TRACE_(seh)( "emulated an RDPID instruction, processor %lu\n", (unsigned long)value );
+    { static unsigned int count; note_emulated( "RDPID", &count ); }
