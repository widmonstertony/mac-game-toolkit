+    if (!is_rosetta2) return FALSE;
+    if (virtual_uninterrupted_read_memory( (BYTE *)RIP_sig(sigcontext) - 1, code, sizeof(code) ) != sizeof(code))
+        return FALSE;
+    if (code[0] != 0x0f || code[1] != 0xa2) return FALSE;
+    memcpy( &target, code + 2, sizeof(target) );
+    if ((ULONG_PTR)siginfo->si_addr != target) return FALSE;
