+/***********************************************************************
+ *           emulate_clwb
+ *
+ * HRAVA_ROSETTA_CLWB: Rosetta 2 has no CLWB (66 0F AE /6 with a memory operand). The
+ * instruction only asks the CPU to write a cache line back; it changes no register, flag
+ * or memory content, so stepping over it is a complete emulation. Active only for a
+ * process whose CPUID leaf 7 was extended with the CLWB bit (see rosetta_extend_cpuid).
+ */
+static inline BOOL emulate_clwb( ucontext_t *sigcontext, CONTEXT *context )
+{
+    BYTE instr[12];
+    unsigned int len = virtual_uninterrupted_read_memory( (BYTE *)context->Rip, instr, sizeof(instr) );
+    unsigned int pos = 1, mod, rm;
+
+    /* only where CPUID says so too: a program must not see CLWB work while leaf 7 denies it */
+    if (!(rosetta_cpuid7_ebx & (1u << 24)) || len < 4 || instr[0] != 0x66) return FALSE;
+    if ((instr[pos] & 0xf0) == 0x40) pos++;                          /* REX */
+    if (len < pos + 3 || instr[pos] != 0x0f || instr[pos + 1] != 0xae) return FALSE;
+    mod = instr[pos + 2] >> 6;
+    rm = instr[pos + 2] & 7;
+    if (mod == 3 || ((instr[pos + 2] >> 3) & 7) != 6) return FALSE;  /* memory operand, /6 */
+    pos += 3;
+    if (rm == 4)                                                     /* SIB */
+    {
+        if (len < pos + 1) return FALSE;
+        if (mod == 0 && (instr[pos] & 7) == 5) pos += 4;             /* disp32, no base */
+        pos++;
+    }
+    else if (mod == 0 && rm == 5) pos += 4;                          /* rip-relative disp32 */
+    if (mod == 1) pos += 1;
+    else if (mod == 2) pos += 4;
+    if (pos > len) return FALSE;
+
+    RIP_sig(sigcontext) += pos;
+    TRACE_(seh)( "emulated a CLWB instruction\n" );
+    { static unsigned int count; note_emulated( "CLWB", &count ); }
+    return TRUE;
+}
