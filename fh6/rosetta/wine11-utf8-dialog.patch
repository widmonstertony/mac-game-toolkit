--- a/dlls/ntdll/utf8_dialog.h
+++ b/dlls/ntdll/utf8_dialog.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Opt-in UTF-8 UI string conversion without changing the process ACP/fonts. */
+static BOOL prefer_utf8_dialog( const char *src, unsigned int len )
+{
+    unsigned int i = 0, ch, need, minimum;
+    BOOL cjk = FALSE;
+    WCHAR value[2];
+    SIZE_T length;
+    while (i < len)
+    {
+        ch = (unsigned char)src[i++];
+        if (ch < 0x80) continue;
+        if (ch >= 0xc2 && ch <= 0xdf) { need = 1; minimum = 0x80; ch &= 0x1f; }
+        else if (ch >= 0xe0 && ch <= 0xef) { need = 2; minimum = 0x800; ch &= 0x0f; }
+        else if (ch >= 0xf0 && ch <= 0xf4) { need = 3; minimum = 0x10000; ch &= 7; }
+        else return FALSE;
+        if (need > len - i) return FALSE;
+        while (need--)
+        {
+            unsigned char byte = src[i++];
+            if ((byte & 0xc0) != 0x80) return FALSE;
+            ch = (ch << 6) | (byte & 0x3f);
+        }
+        if (ch < minimum || ch > 0x10ffff || (ch >= 0xd800 && ch <= 0xdfff)) return FALSE;
+        if ((ch >= 0x3400 && ch <= 0x9fff) || (ch >= 0x3040 && ch <= 0x30ff)) cjk = TRUE;
+    }
+    return cjk && !RtlQueryEnvironmentVariable( NULL, L"WINE_UTF8_DIALOGS", 17,
+                                               value, ARRAY_SIZE(value), &length ) &&
+           length == 1 && value[0] == L'1';
+}
