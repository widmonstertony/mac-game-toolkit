+static BOOL fh6_public_catalog_lookup( const char *id, XStoreProductKind kinds, char record[1024],
+                                      const char **sku, const char **language, const char **offer, const char **title )
+{
+    char *end, *fields[5];
+    unsigned int i;
+    FILE *file;
+    BOOL found = FALSE;
+
+    if (!(kinds & XStoreProductKind_Durable) || !is_fh6_car_pass_product( id )) return FALSE;
+    if (!(file = fopen( "C:\\ProgramData\\MACxus\\fh6-public-catalog.tsv", "rb" ))) return FALSE;
+    while (fgets( record, 1024, file ))
+    {
+        if (!(end = strchr( record, '\n' ))) continue;
+        *end = 0;
+        fields[0] = record;
+        for (i = 1; i < ARRAY_SIZE(fields); i++)
+        {
+            if (!(end = strchr( fields[i-1], '\t' ))) break;
+            *end = 0;
+            fields[i] = end + 1;
+        }
+        if (i != ARRAY_SIZE(fields) || strcmp( fields[0], id ) || !entitled_sku_id( fields[1] ) ||
+            !*fields[2] || !*fields[4] || strchr( fields[4], '\t' )) continue;
+        *sku = fields[1]; *language = fields[2]; *offer = fields[3]; *title = fields[4];
+        found = TRUE;
+        break;
+    }
+    fclose( file );
+    return found;
+}
