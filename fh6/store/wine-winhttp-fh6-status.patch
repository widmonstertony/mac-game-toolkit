 #define ACTUAL_DEFAULT_RECEIVE_RESPONSE_TIMEOUT 21000
 
+/* Optional title diagnostics for an existing private file. Report only fixed
+ * service labels and numeric status, never URLs, account data, or payloads. */
+static const char *status_service( const WCHAR *host )
+{
+    static const struct { const WCHAR *suffix; const char *label; } services[] =
+    {
+        {L"xboxlive.com", "xbox-live"},
+        {L"playfabapi.com", "playfab"},
+        {L"playfab.com", "playfab"},
+        {L"forzamotorsport.net", "forza"},
+        {L"forza.net", "forza"},
+        {L"displaycatalog.mp.microsoft.com", "store-catalog"},
+    };
+    unsigned int i;
+    size_t n, len;
+    if (!host) return NULL;
+    len = wcslen(host);
+    for (i = 0; i < ARRAY_SIZE(services); ++i)
+    {
+        n = wcslen(services[i].suffix);
+        if (len >= n && (len == n || host[len - n - 1] == '.') &&
+            !wcsicmp(host + len - n, services[i].suffix)) return services[i].label;
+    }
+    return NULL;
+}
+
+static void status_note( const char *phase, const char *service, DWORD status, DWORD error )
+{
+    static SRWLOCK lock = SRWLOCK_INIT;
+    static const LARGE_INTEGER zero;
+    DWORD last_error, count, written;
+    LARGE_INTEGER size;
+    char path[MAX_PATH], line[128];
+    HANDLE file;
+
+    if (!service) return;
+    last_error = GetLastError();
+    count = GetEnvironmentVariableA("XODUS_FH6_NET_STATUS", path, sizeof(path));
+    if (!count || count >= sizeof(path)) goto done;
+    count = snprintf(line, sizeof(line), "NET_META phase=%s service=%s status=%lu error=%lu tick=%lu\n",
+                     phase, service, status, error, GetTickCount());
+    if (count >= sizeof(line)) goto done;
+    AcquireSRWLockExclusive(&lock);
+    file = CreateFileA(path, FILE_APPEND_DATA | FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                       NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file != INVALID_HANDLE_VALUE)
+    {
+        if (GetFileSizeEx(file, &size) && size.QuadPart + count <= 32768 &&
+            SetFilePointerEx(file, zero, NULL, FILE_END)) WriteFile(file, line, count, &written, NULL);
+        CloseHandle(file);
+    }
+    ReleaseSRWLockExclusive(&lock);
+done:
+    SetLastError(last_error);
+}
