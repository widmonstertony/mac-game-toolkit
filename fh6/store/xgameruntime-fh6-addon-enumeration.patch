 static const char store_addon_licenses_identity[] = "XStoreQueryAddOnLicenses";
+
+struct store_addon_query
+{
+    LONG refs, canceled, started;
+    char *request;
+    IXThreadingImpl *threading;
+    XAsyncBlock *async;
+    UINT32 count;
+    XStoreAddonLicense licenses[ARRAY_SIZE(fh6_car_pass_products) * ENTITLED_MAX_SKUS];
+};
+
+static void store_addon_query_release( struct store_addon_query *query )
+{
+    if (InterlockedDecrement(&query->refs)) return;
+    IXThreadingImpl_Release(query->threading);
+    free(query->request);
+    free(query);
+}
+
+static DWORD WINAPI store_addon_query_worker( void *arg )
+{
+    struct store_addon_query *query = arg;
+    struct entitled_snapshot *snapshot = NULL;
+    XStoreProduct *product;
+    XStoreSku *sku;
+    XStoreAddonLicense *license;
+    UINT64 now, expiry;
+    UINT32 i, j;
+    HRESULT hr = E_ABORT;
+
+    if (!InterlockedCompareExchange(&query->canceled, 0, 0))
+        hr = entitled_fetch(query->request, &query->canceled, &snapshot);
+    now = time(NULL);
+    if (SUCCEEDED(hr) && (!snapshot || snapshot->proof_until <= now)) hr = E_ACCESSDENIED;
+    if (SUCCEEDED(hr))
+    {
+        for (i = 0; i < snapshot->count; ++i)
+        {
+            product = &snapshot->products[i];
+            if (product->productKind != XStoreProductKind_Durable || product->hasDigitalDownload ||
+                !product->isInUserCollection || !is_fh6_car_pass_product(product->storeId) ||
+                !product->inAppOfferToken ||
+                strlen(product->inAppOfferToken) >= sizeof(license->inAppOfferToken)) continue;
+            for (j = 0; j < product->skusCount; ++j)
+            {
+                sku = &product->skus[j];
+                if (!sku->isInUserCollection || sku->isTrial || sku->collectionData.endDate <= (time_t)now) continue;
+                expiry = min(snapshot->proof_until, (UINT64)sku->collectionData.endDate);
+                if (query->count == ARRAY_SIZE(query->licenses)) { hr = E_UNEXPECTED; break; }
+                license = &query->licenses[query->count++];
+                snprintf(license->skuStoreId, sizeof(license->skuStoreId), "%s/%s", product->storeId, sku->skuId);
+                memcpy(license->inAppOfferToken, product->inAppOfferToken, strlen(product->inAppOfferToken) + 1);
+                license->isActive = TRUE;
+                license->expirationDate = expiry;
+            }
+            if (FAILED(hr)) break;
+        }
+    }
+    if (snapshot) entitled_snapshot_release(snapshot);
+    if (InterlockedCompareExchange(&query->canceled, 0, 0)) hr = E_ABORT;
+    xodus_store_license_note("fh6-addon-licenses-result", hr);
+    IXThreadingImpl_XAsyncComplete(query->threading, query->async, hr,
+                                  SUCCEEDED(hr) ? query->count * sizeof(*license) : 0);
+    store_addon_query_release(query);
+    return 0;
+}
 
+static HRESULT WINAPI store_addon_query_provider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    struct store_addon_query *query = data->context;
+    SIZE_T size;
+    HANDLE worker;
+    HRESULT hr;
+
+    switch (op)
+    {
+    case XAsyncOp_Begin: return IXThreadingImpl_XAsyncSchedule(query->threading, data->async, 0);
+    case XAsyncOp_DoWork:
+        if (InterlockedCompareExchange(&query->started, 1, 0)) return E_PENDING;
+        if (InterlockedCompareExchange(&query->canceled, 0, 0)) return E_ABORT;
+        query->async = data->async;
+        InterlockedIncrement(&query->refs);
+        if (!(worker = CreateThread(NULL, 0, store_addon_query_worker, query, 0, NULL)))
+        {
+            hr = HRESULT_FROM_WIN32(GetLastError());
+            store_addon_query_release(query);
+            return hr;
+        }
+        CloseHandle(worker);
+        return E_PENDING;
+    case XAsyncOp_GetResult:
+        size = query->count * sizeof(query->licenses[0]);
+        if (size && (!data->buffer || data->bufferSize < size)) return E_INVALIDARG;
+        if (size) memcpy(data->buffer, query->licenses, size);
+        return S_OK;
+    case XAsyncOp_Cancel: InterlockedExchange(&query->canceled, TRUE); return S_OK;
+    case XAsyncOp_Cleanup: store_addon_query_release(query); return S_OK;
+    default: return E_NOTIMPL;
+    }
+}
