+/* Run a same-process GPU interop operation between segments of one D3D12 list.
+ * The callback must wait for its external GPU work, may not enter D3D12 or
+ * Vulkan, and must return failure if its output was not written. */
+HRESULT WINAPI VKD3DRecordHostPass(ID3D12CommandList *iface,
+        void (WINAPI *prepare)(IUnknown *), HRESULT (WINAPI *execute)(IUnknown *), IUnknown *context)
+{
+    struct d3d12_command_list *list = iface ? d3d12_command_list_from_iface(iface) : NULL;
+    struct d3d12_command_allocator *allocator;
+    unsigned int count;
+
+    if (!list || !execute || !context || !list->is_recording)
+        return E_INVALIDARG;
+
+    allocator = list->allocator;
+    count = list->cmd.iteration_count;
+    if (list->type != D3D12_COMMAND_LIST_TYPE_DIRECT ||
+            count >= VKD3D_MAX_COMMAND_LIST_SEQUENCES ||
+            !d3d12_command_list_allows_new_sequence(list) ||
+            (list->rendering_info.state_flags & VKD3D_RENDERING_ACTIVE))
+        return E_NOTIMPL;
+
+    if (!vkd3d_array_reserve((void **)&allocator->host_passes, &allocator->host_passes_size,
+            allocator->host_passes_count + 1, sizeof(*allocator->host_passes)))
+        return E_OUTOFMEMORY;
+
+    /* Keep staging alive even if splitting fails after the prefix was recorded. */
+    IUnknown_AddRef(context);
+    allocator->host_passes[allocator->host_passes_count++] = (struct vkd3d_host_pass){execute, context};
+    if (prepare)
+        prepare(context);
+    d3d12_command_list_end_transfer_batch(list);
+    d3d12_command_list_flush_subresource_updates(list);
+    d3d12_command_list_begin_new_sequence(list, false);
+    if (list->cmd.iteration_count != count + 1)
+        return E_FAIL;
+
+    list->cmd.iterations[count].host_pass_index = allocator->host_passes_count;
+    return S_OK;
+}
