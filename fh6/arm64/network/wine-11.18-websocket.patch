+/* Every receive outside netconn_create and netconn_is_alive is meant to block, as on Windows. If the socket
+ * answers WSAEWOULDBLOCK anyway, wait for data instead of failing: callers treat a failed read as a dead
+ * connection (a WebSocket receive then errors out) or, when the error code is lost, as a zero-byte read they
+ * retry at once -- Forza Horizon 6 spun on six WebSockets that way, ~15000 recv calls a second each, starving
+ * its online services. The wait honours SO_RCVTIMEO, so the WebSocket keepalive still sees WSAETIMEDOUT.
+ * The error code is set again after the WARN, which must not be the one to decide it. */
+static int sock_recv( struct netconn *conn, void *msg, size_t len, int flags )
+{
+    int ret, err;
+
+    for (;;)
+    {
+        if ((ret = recv( conn->socket, msg, len, flags )) != -1) return ret;
+        err = WSAGetLastError();
+        if (err == WSAEINTR) continue;
+        if (err == WSAEWOULDBLOCK && !conn->nonblocking)
+        {
+            WSAPOLLFD pfd;
+            DWORD timeout = 0;
+            int optlen = sizeof(timeout), res;
+
+            if (getsockopt( conn->socket, SOL_SOCKET, SO_RCVTIMEO, (char *)&timeout, &optlen )) timeout = 0;
+            pfd.fd = conn->socket;
+            pfd.events = POLLRDNORM;
+            pfd.revents = 0;
+            if ((res = WSAPoll( &pfd, 1, timeout ? (int)timeout : -1 )) > 0) continue;
+            err = res ? WSAGetLastError() : WSAETIMEDOUT;
+        }
+        WARN( "recv error %d\n", err );
+        WSASetLastError( err );
+        return -1;
+    }
 }
 
